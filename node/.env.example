# Octopus Agent System — Configuration
# Copy to .env and fill in the values for your setup.

# ── Server ────────────────────────────────────────────────────────────────────

# REST API + WebSocket port (default: 3001)
PORT=3001

# Python Memory Service URL (default: http://localhost:5000)
MEMORY_SERVICE_URL=http://localhost:5000

# Path to the data directory (relative to node/ or absolute)
DATA_DIR=../data

# (Optional) Redis URL for the L4 prompt cache. Falls back to in-memory if unset.
REDIS_URL=

# ── Safety & Security ─────────────────────────────────────────────────────────

# SAFE_MODE=true  → disables file-write and shell-command MCP tools (default)
# SAFE_MODE=false → enables file writes and commands (local dev only)
SAFE_MODE=true

# AgentShield scan mode: none | advisory | gate (blocking)
AGENTSHIELD_MODE=advisory

# ── Headless Mode ─────────────────────────────────────────────────────────────
# HEADLESS_MODE=false (default): Cortex is the planner; chains run automatically.
# HEADLESS_MODE=true:  Disable auto-planning; an external LLM (Claude, GPT-4o,
#   Gemini) calls octopus_* tools directly. Use this when Octopus is the
#   tool/safety layer and Claude Desktop / Cursor is the primary planner.
#
# Recommended MCP config for headless Claude Desktop:
#   { "mcpServers": { "octopus": { "command": "node",
#       "args": ["/path/to/octopus/node/src/mcp.js"],
#       "env": { "HEADLESS_MODE": "true" } } } }
HEADLESS_MODE=false

# ── Multi-LLM Gateway ─────────────────────────────────────────────────────────
# Provider: anthropic | openai | google | ollama | nvidia | huggingface | custom_http | router
# (default: anthropic)
LLM_PROVIDER=anthropic

# Model override — provider defaults:
#   anthropic   → claude-sonnet-4-6
#   openai      → gpt-4o
#   google      → gemini-2.0-flash
#   ollama      → gemma4:e2b  (set SOVEREIGN_FALLBACK_MODEL for override)
#   nvidia      → meta/llama-3.1-405b-instruct
#   huggingface → google/gemma-3-4b-it
#   custom_http → value of CUSTOM_HTTP_MODEL (see below)
LLM_MODEL=

# Per-provider API keys — only the key for your chosen provider is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── NVIDIA NIM (free trial at build.nvidia.com) ────────────────────────────────
# LLM_PROVIDER=nvidia
# Recommended models: meta/llama-3.1-405b-instruct, moonshotai/kimi-k2-thinking,
#   qwen/qwen2.5-coder-32b-instruct, deepseek-ai/deepseek-v4-pro (1M ctx)
NVIDIA_API_KEY=

# ── HuggingFace Inference API (free tier, 100k+ models including Gemma) ────────
# Sign up at huggingface.co → Settings → Access Tokens (read, free)
# LLM_PROVIDER=huggingface
# LLM_MODEL=google/gemma-3-4b-it   (or google/gemma-3-27b-it, etc.)
HF_TOKEN=

# ── Ollama (local inference, no API key required) ──────────────────────────────
# Pull models first: ollama pull gemma4:e2b
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma4:e2b
OLLAMA_BASE_URL=http://localhost:11434

# Sovereign fallback: if the selected cloud provider has no API key, Octopus
# automatically falls back to this local Ollama model (default: gemma4:e2b)
SOVEREIGN_FALLBACK_MODEL=gemma4:e2b

# ── Custom HTTP backend (JAX/Gemma server, vLLM, LM Studio, llamafile, etc.) ──
# Any server that speaks the OpenAI /v1/chat/completions API.
# LLM_PROVIDER=custom_http
# CUSTOM_HTTP_URL=http://localhost:8080
# CUSTOM_HTTP_MODEL=gemma-3-4b-it
CUSTOM_HTTP_URL=
CUSTOM_HTTP_MODEL=

# ── Caller-aware routing ──────────────────────────────────────────────────────
# Set OCTOPUS_CALLER in the MCP client's env block to auto-select provider/model.
# Values: claude | openai | gemini | ollama | nvidia | huggingface | custom
# Example for Claude Desktop: "env": { "OCTOPUS_CALLER": "claude" }
# OCTOPUS_CALLER=

# ── Learning & Continuous Improvement ─────────────────────────────────────────
MAX_THINKING_TOKENS=10000
COMPACT_THRESHOLD=50
ECC_HOOK_PROFILE=standard
ECC_RULES_PATH=.claude/rules

# ── Workspace ─────────────────────────────────────────────────────────────────
PROJECT_ROOT=.

# ── Notifications ─────────────────────────────────────────────────────────────
# Slack/Discord webhook URL — posted on chain completion (optional)
OCTOPUS_WEBHOOK_URL=

# ── GitHub (MarketScout) ──────────────────────────────────────────────────────
# Raises GitHub Search rate limit from 10 → 30 req/min (unauthenticated → authenticated)
GITHUB_TOKEN=
