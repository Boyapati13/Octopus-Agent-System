# Octopus Agent System Configuration

# The URL of the Python Memory Service
MEMORY_SERVICE_URL=http://localhost:5000

# The path to the data directory (relative to the node project or absolute)
DATA_DIR=../data

# The port for the Node API server
PORT=3001

# (Optional) Redis URL for the caching layer (L4). If empty, falls back to in-memory map.
REDIS_URL=

# Safety Mode: If true, disables mutating MCP tools (e.g. octopus_run_task_chain)
SAFE_MODE=true

# ── Multi-LLM Gateway ─────────────────────────────────────────────────────────
# Provider: anthropic | openai | google | ollama  (default: anthropic)
LLM_PROVIDER=anthropic

# Model override — defaults per provider:
#   anthropic → claude-sonnet-4-6
#   openai    → gpt-4o
#   google    → gemini-2.0-flash
#   ollama    → llama3.2
LLM_MODEL=

# API keys — only the key for your chosen provider is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# ── Ollama (local / self-hosted) ───────────────────────────────────────────────
# Base URL of your Ollama instance (default: http://localhost:11434)
# Tool-calling requires a compatible model: llama3.1, llama3.2, mistral-nemo, qwen2.5
OLLAMA_BASE_URL=http://localhost:11434

# ── MarketScout — GitHub token (optional) ─────────────────────────────────────
# Raises GitHub Search rate limit from 10 → 30 req/min (unauthenticated → authenticated)
GITHUB_TOKEN=
